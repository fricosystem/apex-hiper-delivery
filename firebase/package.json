{
  "name": "@hiper/firebase",
  "version": "0.1.0",
  "private": true,
  "description": "Security Rules do Firestore e do Storage, com testes de isolamento no emulador.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:rules": "firebase emulators:exec --project demo-hiper-delivery --config ../firebase.json --only firestore,storage \"vitest run\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@hiper/shared": "workspace:*",
    "@types/node": "^22.19.0",
    "firebase": "^13.1.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
