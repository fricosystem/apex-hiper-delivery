# Fonte de dados: "firebase" (padrão) ou "demo" (dados de exemplo, sem backend).
EXPO_PUBLIC_DATA_SOURCE=firebase

# Projeto Firebase (Configurações do projeto > Seus apps > App da Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-hiper-delivery
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_APP_ID=

# "1" liga o app aos emuladores locais (pnpm emulators na raiz).
EXPO_PUBLIC_USE_EMULATORS=1
# IP da máquina com os emuladores; no Android use o IP da rede, não 127.0.0.1.
EXPO_PUBLIC_EMULATOR_HOST=127.0.0.1

# Mapa, rotas e geocodificação (todos gratuitos; em produção use instâncias próprias).
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
EXPO_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org
