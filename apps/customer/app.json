{
  "expo": {
    "name": "Hiper Delivery",
    "slug": "hiper-delivery-cliente",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hiperdelivery",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.hiperdelivery.cliente",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "br.com.hiperdelivery.cliente",
      "adaptiveIcon": {
        "backgroundColor": "#E8442E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Hiper Delivery",
      "themeColor": "#E8442E",
      "lang": "pt-BR"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8442E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localiza\u00e7\u00e3o para sugerir o endere\u00e7o de entrega."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
